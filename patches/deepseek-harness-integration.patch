diff --git a/packages/client/ui-model-selection/src/client/provider-label.ts b/packages/client/ui-model-selection/src/client/provider-label.ts
new file mode 100644
index 0000000..9571035
--- /dev/null
+++ b/packages/client/ui-model-selection/src/client/provider-label.ts
@@ -0,0 +1,6 @@
+/** Return a selector label that distinguishes routes serving the same model. */
+export function displayProviderName(provider: string, name: string): string {
+  if (provider === 'deepseek-official') return 'Official DeepSeek'
+  if (provider === 'opencode-go') return 'OpenCode DeepSeek'
+  return name
+}
